#!/usr/bin/env bash
# PRIME offload wrapper for discrete NVIDIA GPU execution
set -euo pipefail

if [ "$#" -eq 0 ]; then
    echo "Usage: gpu-offload <command> [args...]"
    exit 1
fi

export DRI_PRIME=1
export __NV_PRIME_RENDER_OFFLOAD=1
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export __VK_LAYER_NV_optimus=NVIDIA_only

exec "$@"
