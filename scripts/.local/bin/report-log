#!/usr/bin/env bash
# Run any command, save output to ags_error.log and push to GitHub for instant analysis

LOG_FILE="ags_error.log"
echo "==> Running command and capturing output..."
"$@" > "$LOG_FILE" 2>&1

echo "==> Uploading log to GitHub..."
git add "$LOG_FILE" 2>/dev/null || true
git commit -m "Upload runtime error log" 2>/dev/null || true
git push origin main 2>/dev/null || true

echo "=========================================="
echo "==> Log uploaded! Tell the AI assistant to read ags_error.log."
echo "=========================================="
