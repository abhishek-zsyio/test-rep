#!/usr/bin/env bash
# Laptop battery threshold limit setter (IdeaPad VPC2004 conservation mode)
set -euo pipefail

LIMIT="${1:-80}"
PATH_CONSERVATION="/sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/conservation_mode"

if [ -f "$PATH_CONSERVATION" ]; then
    if [ "$LIMIT" -le 60 ]; then
        echo 1 | sudo tee "$PATH_CONSERVATION" >/dev/null
        echo "IdeaPad conservation mode ENABLED (capped at 60%)"
    else
        echo 0 | sudo tee "$PATH_CONSERVATION" >/dev/null
        echo "IdeaPad conservation mode DISABLED (charging to 100%)"
    fi
else
    echo "Conservation mode sysfs node not found. Ensure ideapad_acpi driver is active."
    exit 1
fi
