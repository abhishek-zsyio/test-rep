#!/usr/bin/env bash
# Flexible Wallpaper Switcher & Cycler for current theme
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"

ACTIVE_THEME_DIR="$HOME/.config/themes/active"
if [ ! -d "$ACTIVE_THEME_DIR" ] && [ -d "$DOTFILES_DIR/themes/.config/themes/active" ]; then
    ACTIVE_THEME_DIR="$DOTFILES_DIR/themes/.config/themes/active"
fi

WALLPAPERS_DIR="$ACTIVE_THEME_DIR/wallpapers"
CACHE_FILE="$HOME/.cache/current-wallpaper"

mkdir -p "$HOME/.cache"

# Collect wallpapers in current theme directory
WALLPAPERS=()
if [ -d "$WALLPAPERS_DIR" ]; then
    while IFS= read -r -d '' file; do
        WALLPAPERS+=("$file")
    done < <(find "$WALLPAPERS_DIR" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.webp" \) -print0 | sort -z)
fi

ACTION="${1:-next}"

if [ "${#WALLPAPERS[@]}" -eq 0 ]; then
    # Fallback to solid background color from hypr.conf if no wallpapers found
    if [ -f "$ACTIVE_THEME_DIR/hypr.conf" ]; then
        BG_COLOR=$(grep -E '^\$bg_color =' "$ACTIVE_THEME_DIR/hypr.conf" | awk '{print $3}' || echo "0x191724")
        hyprctl keyword misc:background_color "$BG_COLOR" 2>/dev/null || true
    fi
    echo "No wallpaper images found in $WALLPAPERS_DIR. Applied solid theme background."
    exit 0
fi

CURRENT_WALL=$(cat "$CACHE_FILE" 2>/dev/null || echo "")
INDEX=-1

for i in "${!WALLPAPERS[@]}"; do
    if [ "${WALLPAPERS[$i]}" = "$CURRENT_WALL" ]; then
        INDEX=$i
        break
    fi
done

NEW_INDEX=0

case "$ACTION" in
    next)
        NEW_INDEX=$(( (INDEX + 1) % ${#WALLPAPERS[@]} ))
        ;;
    prev)
        NEW_INDEX=$(( (INDEX - 1 + ${#WALLPAPERS[@]}) % ${#WALLPAPERS[@]} ))
        ;;
    random)
        NEW_INDEX=$(( RANDOM % ${#WALLPAPERS[@]} ))
        ;;
    init)
        if [ "$INDEX" -ge 0 ]; then
            NEW_INDEX=$INDEX
        else
            NEW_INDEX=0
        fi
        ;;
    *)
        if [ -f "$ACTION" ]; then
            SELECTED_WALL="$ACTION"
            echo "$SELECTED_WALL" > "$CACHE_FILE"
            ln -sfn "$SELECTED_WALL" "$ACTIVE_THEME_DIR/wallpaper" 2>/dev/null || true
            if command -v swww &>/dev/null; then
                swww img "$SELECTED_WALL" --transition-type wipe --transition-duration 1 2>/dev/null || true
            fi
            echo "Wallpaper set to: $SELECTED_WALL"
            exit 0
        fi
        ;;
esac

SELECTED_WALL="${WALLPAPERS[$NEW_INDEX]}"
echo "$SELECTED_WALL" > "$CACHE_FILE"
ln -sfn "$SELECTED_WALL" "$ACTIVE_THEME_DIR/wallpaper" 2>/dev/null || true

# Apply wallpaper with swww if daemon is active
if command -v swww &>/dev/null && swww query &>/dev/null; then
    swww img "$SELECTED_WALL" --transition-type wipe --transition-duration 1 2>/dev/null || true
fi

echo "Wallpaper switched to: $(basename "$SELECTED_WALL") (${NEW_INDEX+1}/${#WALLPAPERS[@]})"
