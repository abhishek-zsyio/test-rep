#!/usr/bin/env bash
set -euo pipefail

THEMES_DIR="$HOME/.config/themes"
NEW_THEME="${1:-}"

if [ -z "$NEW_THEME" ]; then
    echo "Usage: theme-switch <theme-name>"
    echo "Available themes:"
    ls -1 "$THEMES_DIR" | grep -v 'active'
    exit 1
fi

if [ ! -d "$THEMES_DIR/$NEW_THEME" ]; then
    echo "Error: theme '$NEW_THEME' does not exist in $THEMES_DIR"
    exit 1
fi

ln -sfn "$NEW_THEME" "$THEMES_DIR/active.tmp"
mv -T "$THEMES_DIR/active.tmp" "$THEMES_DIR/active"

hyprctl reload 2>/dev/null || true
ags request reload-styles 2>/dev/null || true
kitty @ set-colors -a -c "$THEMES_DIR/active/kitty.conf" 2>/dev/null || true

if [ -f "$THEMES_DIR/active/qt-theme-name" ]; then
    gsettings set org.gnome.desktop.interface gtk-theme "$(cat "$THEMES_DIR/active/qt-theme-name")" 2>/dev/null || true
fi

WALLPAPER="$THEMES_DIR/active/wallpaper.png"
if [ -f "$WALLPAPER" ]; then
    if command -v swww &>/dev/null; then
        for mon in $(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null || echo ""); do
            if [ -n "$mon" ]; then
                swww img "$WALLPAPER" --outputs "$mon" --transition-type wipe --transition-duration 1 2>/dev/null || true
            fi
        done
    fi
fi

mkdir -p "$HOME/.cache"
echo "$NEW_THEME" > "$HOME/.cache/current-theme"
echo "Switched theme to $NEW_THEME"
