#!/usr/bin/env bash
set -euo pipefail

HARDWARE_DIR="$HOME/.config/hypr/hardware"
TARGET="${1:-}"

if [ -z "$TARGET" ]; then
    echo "Usage: hardware-switch <vm|laptop>"
    exit 1
fi

PROFILE="$HARDWARE_DIR/$TARGET.lua"

if [ ! -f "$PROFILE" ]; then
    echo "Error: hardware profile '$PROFILE' not found"
    exit 1
fi

ln -sfn "$TARGET.lua" "$HARDWARE_DIR/active.lua.tmp"
mv -T "$HARDWARE_DIR/active.lua.tmp" "$HARDWARE_DIR/active.lua"

hyprctl reload 2>/dev/null || true
echo "Hardware profile switched to $TARGET ($PROFILE)"
